{
  "name": "sol-astra-field-atlas",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate-icons.mjs && vite build && node scripts/static-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint --type-aware --type-check",
    "typecheck": "tsrs --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun": "^1.4.4",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "bun@1.4.4"
}
